; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Man Vs Machine"
config/description="An arcade 2D fighting game: one human boxer against a roster of combat robots."
run/main_scene="res://scenes/menus/main_menu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/ui/icon.png"

[autoload]

Settings="*res://scripts/autoload/settings.gd"
Audio="*res://scripts/autoload/audio.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

